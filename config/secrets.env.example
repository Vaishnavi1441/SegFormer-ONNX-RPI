# ==============================================================================
# UAV AUTONOMOUS SYSTEM - EXTERNAL API KEYS & ENVIRONMENT CONFIGURATION
# Copy this file to .env or config/secrets.env and input your free keys
# ==============================================================================

# 1. Mapbox API Key (Free tier: 50,000 map loads/month)
# For high-resolution satellite imagery tiles in GCS
# Get free key at: https://account.mapbox.com/
MAPBOX_ACCESS_TOKEN=pk.your_free_mapbox_token_here

# 2. OpenWeatherMap API Key (Free tier: 1,000 calls/day)
# For real-time wind speed, gusts, air density & flight safety envelope
# Get free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_free_openweathermap_api_key_here

# 3. Open-Elevation / USGS Elevation API (Optional: free public endpoint default)
# For terrain following & Above-Ground-Level (AGL) elevation clearance
OPEN_ELEVATION_API_URL=https://api.open-elevation.com/api/v1/lookup

# 4. Google Gemini / OpenAI API Key (Optional for Open-Domain Voice Conversational Reasoning)
# Get free Gemini API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_free_gemini_api_key_here
